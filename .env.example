# ============================================================
# SDPRS 環境變數配置模板
# Smart Disaster Prevention Response System
# ============================================================
# 複製此檔案為 .env 並填入實際值
#   本地 LAN:  cp .env.example .env
#   Zeabur:    在 Zeabur 環境變數面板逐項填入（不需要 .env 檔案）
# ============================================================

# ------------------------------------------------------------
# 儀表板認證（保安人員登入）
# ------------------------------------------------------------
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme

# ------------------------------------------------------------
# 邊緣節點認證（Pi → Server API，X-API-Key header）
# 這是「Legacy 共用金鑰」，作為 per-node 金鑰之外的過渡期後備方案，現已改為選填：
#   - 留空（或整行刪除／註解）= 只用 per-node 金鑰驗證（推薦；透過儀表板「設定金鑰」
#     或 POST /api/nodes/{node_id}/key 為每個節點各發一把 sk-edge-… 金鑰）
#   - 若仍要設定，務必用強隨機值（例如 `openssl rand -hex 32`），弱值／預留字會啟動失敗
# ------------------------------------------------------------
#EDGE_API_KEY=your-edge-api-key-here

# ------------------------------------------------------------
# Session 加密
# ------------------------------------------------------------
SECRET_KEY=your-secret-key-change-in-production

# ------------------------------------------------------------
# MQTT Broker 配置
# 本地 LAN:  MQTT_BROKER=localhost，MQTT_USE_TLS=false
# Zeabur:    MQTT_BROKER=mosquitto（Zeabur 內網服務名），MQTT_USE_TLS=false
# ------------------------------------------------------------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# ------------------------------------------------------------
# 資料庫配置
# 本地 LAN:  DATABASE_URL 留空，使用 SQLite
# Zeabur:    填入 PostgreSQL 連線串（由 Zeabur PG 服務自動提供）
# ------------------------------------------------------------
DATABASE_URL=
DB_PATH=./data/sdprs.db

# ------------------------------------------------------------
# 媒體保留 & 儲存路徑
# ------------------------------------------------------------
RETENTION_DAYS=30
STORAGE_PATH=./storage

# 單一請求 body 的硬上限（bytes），由 BodySizeLimitMiddleware 在「任何緩衝發生之前」
# 擋下——它是最外層 middleware，比認證還早，因為認證之後才擋，未認證的用戶端仍然可以
# 先把無上限的 body 灌進 multipart parser 才被回 401。
#
# 必須「大於」alerts.upload_video 的單檔上限（100 MB）：這裡是保護 parser 的粗篩，
# 那裡才是精確的單檔限制。設得比單檔上限低，會讓每一支合法的滿版影片都被拒絕。
MAX_UPLOAD_BYTES=115343360

# ------------------------------------------------------------
# 伺服器配置
# Zeabur 會自動注入 $PORT，無需手動設定
# ------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
